# Required for the assistant (chat/do). The video pipeline works without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# JARVIS_MODEL=claude-opus-5
# JARVIS_EFFORT=high            # low | medium | high | xhigh | max
# JARVIS_VOICE=en-GB-RyanNeural # any `edge-tts --list-voices` entry
# JARVIS_USER_TITLE=Sir
# JARVIS_AUTO_APPROVE=0         # 1 = run shell/upload without asking (careful)
# JARVIS_WHISPER_MODEL=base     # tiny | base | small | medium | large-v3
