{
  "name": "ifterwards",
  "version": "0.1.0",
  "private": true,
  "description": "Ifterwards: animated \"What if you...\" stories. Remotion assembles the video, Three.js builds the 3D sets.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "sheet": "remotion still src/index.ts StickmanSheet characters/stickman/sheet.png",
    "typecheck": "tsc --noEmit",
    "coldopen": "remotion render src/index.ts Ep01ColdOpenTest episodes/ep01/renders/tests/cold-open-test.mp4 --concurrency=4",
    "daycard": "remotion render src/index.ts DayCardDemo episodes/ep01/renders/tests/day-card-demo.mp4"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/captions": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "@remotion/media-utils": "4.0.542",
    "@remotion/three": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "7.0.2"
  }
}
